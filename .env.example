# Public build-time configuration only. Never place secrets in EXPO_PUBLIC_ variables.
# Development web app: http://localhost:8000/api/v1
# Production: replace with the HTTPS URL of the deployed API.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_APP_ENV=development

# Local Docker PostgreSQL only. Use a different value outside local development.
SALASAR_POSTGRES_DB=salasar
SALASAR_POSTGRES_USER=salasar_app
SALASAR_POSTGRES_PASSWORD=replace-with-a-long-random-local-password
