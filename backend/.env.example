SALASAR_APP_NAME=Salasar API
SALASAR_APP_VERSION=0.1.0
SALASAR_API_PREFIX=/api/v1
SALASAR_ENVIRONMENT=development
SALASAR_DATABASE_URL=postgresql+psycopg://salasar_app:change-this-local-password@localhost:5434/salasar
SALASAR_JWT_SECRET=change-me
SALASAR_JWT_ALGORITHM=HS256
SALASAR_ACCESS_TOKEN_EXPIRE_MINUTES=480
# JSON array of exact browser origins allowed to call the API. Do not use '*' with credentials.
SALASAR_CORS_ORIGINS=["http://localhost:8081","http://localhost:8082"]

# Tata Fleet Edge push receiver. Generate a unique 32+ character secret per environment.
SALASAR_TATA_FLEET_WEBHOOK_ENABLED=false
SALASAR_TATA_FLEET_WEBHOOK_SECRET=replace-with-a-long-random-secret
SALASAR_TATA_FLEET_MAX_PAYLOAD_BYTES=1048576
